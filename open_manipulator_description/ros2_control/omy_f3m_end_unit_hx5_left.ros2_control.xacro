                    Tool Bus EEPROM (Tool ID, Tool Baud Rate, Tool Protocol,
                    SyncTable Read/Write addresses & sizes) is pre-configured
                    via Dynamixel Wizard and persists in EEPROM. Add any
                    extra RAM init here in the future if needed.
           ════════════════════════════════════════════════════════════════════ -->
      <gpio name="omy_end_init">
        <param name="type">controller</param>
        <param name="ID">210</param>
      </gpio>

      <!-- ════════════════════════════════════════════════════════════════════
           [Step 7] OMY END (ID 210) — Enable SyncTable + SyncTable HX5
                    Final step: arm the OMY END→Tool Bus relay so HX5 motors
                    receive Goal Position / Goal Current commands.
           ════════════════════════════════════════════════════════════════════ -->
      <gpio name="omy_end_post">
        <param name="type">controller</param>
        <param name="ID">210</param>
        <param name="SyncTable Enable">1</param>
        <param name="SyncTable Enable HX5">1</param>
      </gpio>

    </ros2_control>
  </xacro:macro>
</robot>
