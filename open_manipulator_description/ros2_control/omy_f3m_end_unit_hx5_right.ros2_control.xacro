<?xml version="1.0"?>
<!--
  omy_f3m_end_unit_hx5_right.ros2_control.xacro

  HX5 right hand driven through OMY END (ID 210) SyncTable relay.
  Simplified version with preset grasp/release motions controlled by trigger.
  
  Preset trigger mapping:
    - trigger closed (t=1.0):  hand fully grasped
    - trigger open   (t=0.0):  hand fully relaxed
    - trigger mid    (0<t<1):  blended between grasp and release

  Joint naming: finger_r_joint1..20 (instead of finger_l_joint)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="omy_f3m_end_unit_hx5_right_system" params="name prefix port_name:=^|/dev/ttyAMA4 dynamixel_model_folder:=^|/param/dxl_model configure_hx5_synctable:=^|false use_sim:=^|false use_mock_hardware:=^|false mock_sensor_commands:=^|false">
    <ros2_control name="${name}" type="system" is_async="true">
      <xacro:if value="$(arg use_sim)">
        <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
      </xacro:if>
      <xacro:unless value="$(arg use_sim)">
        <hardware>
          <xacro:if value="${use_mock_hardware}">
            <plugin>mock_components/GenericSystem</plugin>
            <param name="mock_sensor_commands">${mock_sensor_commands}</param>
            <param name="state_following_offset">0.0</param>
          </xacro:if>
          <xacro:unless value="${use_mock_hardware}">
            <plugin>dynamixel_hardware_interface/DynamixelHardware</plugin>
            <param name="port_name">${port_name}</param>
            <param name="baud_rate">4000000</param>
            <param name="error_timeout_ms">500</param>
            <param name="dynamixel_model_folder">${dynamixel_model_folder}</param>
            <param name="number_of_joints">20</param>
            <param name="number_of_transmissions">20</param>
            <param name="disable_torque_at_init">true</param>
            <param name="dynamixel_state_pub_msg_name">dynamixel_hardware_interface/dxl_state</param>
            <param name="get_dynamixel_data_srv_name">dynamixel_hardware_interface/get_dxl_data</param>
            <param name="set_dynamixel_data_srv_name">dynamixel_hardware_interface/set_dxl_data</param>
            <param name="reboot_dxl_srv_name">dynamixel_hardware_interface/reboot_dxl</param>
            <param name="set_dxl_torque_srv_name">dynamixel_hardware_interface/set_dxl_torque</param>
          </xacro:unless>
        </hardware>
      </xacro:unless>

      <!-- Joint/Sensor interface declarations -->
      <!-- Finger 1 joints -->
      <joint name="${prefix}finger_r_joint1">
        <command_interface name="position"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}finger_r_joint2">
        <command_interface name="position"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}finger_r_joint3">
        <command_interface name="position"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}finger_r_joint4">
        <command_interface name="position"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <!-- Finger 2 joints -->
      <joint name="${prefix}finger_r_joint5">
        <command_interface name="position"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}finger_r_joint6">
        <command_interface name="position"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}finger_r_joint7">
        <command_interface name="position"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}finger_r_joint8">
        <command_interface name="position"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <!-- Finger 3 joints -->
      <joint name="${prefix}finger_r_joint9">
        <command_interface name="position"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}finger_r_joint10">
        <command_interface name="position"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}finger_r_joint11">
        <command_interface name="position"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}finger_r_joint12">
        <command_interface name="position"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <!-- Finger 4 joints -->
      <joint name="${prefix}finger_r_joint13">
        <command_interface name="position"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}finger_r_joint14">
        <command_interface name="position"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}finger_r_joint15">
        <command_interface name="position"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}finger_r_joint16">
        <command_interface name="position"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <!-- Finger 5 joints -->
      <joint name="${prefix}finger_r_joint17">
        <command_interface name="position"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}finger_r_joint18">
        <command_interface name="position"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}finger_r_joint19">
        <command_interface name="position"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}finger_r_joint20">
        <command_interface name="position"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <sensor name="${prefix}finger_r_sensor1"><state_interface name="Present Pressure 5"/></sensor>
      <sensor name="${prefix}finger_r_sensor2"><state_interface name="Present Pressure 5"/></sensor>
      <sensor name="${prefix}finger_r_sensor3"><state_interface name="Present Pressure 5"/></sensor>
      <sensor name="${prefix}finger_r_sensor4"><state_interface name="Present Pressure 5"/></sensor>
      <sensor name="${prefix}finger_r_sensor5"><state_interface name="Present Pressure 5"/></sensor>

      <!-- OMY END pre-init (disable SyncTable) -->
      <gpio name="omy_end_pre">
        <state_interface name="Button Status"/>
        <param name="type">controller</param>
        <param name="ID">210</param>
        <param name="Baud Rate (Bus)">6</param>
        <param name="SyncTable Enable">0</param>
        <param name="Tool Analog Enable">0</param>
        <param name="Tool Baud Rate">8</param>
        <param name="Tool Protocol">0</param>
        <param name="Tool ID">110</param>
        <param name="R LED">200</param>
        <param name="G LED">200</param>
        <param name="B LED">120</param>
        <param name="SyncTable Read Address">634</param>
        <param name="SyncTable Read Size">125</param>
        <param name="SyncTable Write Address">799</param>
        <param name="SyncTable Write Size">80</param>
      </gpio>

      <!-- HX5 hub (ID 110) init + SyncTable config -->
      <gpio name="hand_r_controller">
        <param name="type">controller</param>
        <param name="ID">110</param>
        <!-- <param name="Bus Watchdog">100</param> -->
      </gpio>

      <!-- Motor init: simplified - only essential params for grasp/release -->
      <!-- Finger 1 motors -->
                        
      <!-- Finger 2 motors (simplified - only IDs 116-119) -->
                        
      <!-- Finger 3 motors -->
                        
      <!-- Finger 4 motors -->
                        
      <!-- Finger 5 motors -->
                        
      <!-- HX5 hub - enable SyncTable -->
      <gpio name="hand_r_controller_dummy">
        <param name="type">controller</param>
        <param name="ID">110</param>
        <!-- <param name="Table Sync Enable">1</param> -->
      </gpio>

      <!-- Virtual DXL/Sensor mapping via OMY END (comm_id=210) -->
      <gpio name="dxl111">
        <command_interface name="Goal Position"/>
        <command_interface name="Goal Current"/>
        <state_interface name="Present Position"/>
        <state_interface name="Present Velocity"/>
        <state_interface name="Present Current"/>
        <param name="type">virtual_dxl</param>
        <param name="ID">111</param>
        <param name="comm_id">210</param>
        <param name="model_num">6001</param>
      </gpio>

      <gpio name="dxl112">
        <command_interface name="Goal Position"/>
        <command_interface name="Goal Current"/>
        <state_interface name="Present Position"/>
        <state_interface name="Present Velocity"/>
        <state_interface name="Present Current"/>
        <param name="type">virtual_dxl</param>
        <param name="ID">112</param>
        <param name="comm_id">210</param>
        <param name="model_num">6002</param>
      </gpio>

      <gpio name="dxl113">
        <command_interface name="Goal Position"/>
        <command_interface name="Goal Current"/>
        <state_interface name="Present Position"/>
        <state_interface name="Present Velocity"/>
        <state_interface name="Present Current"/>
        <param name="type">virtual_dxl</param>
        <param name="ID">113</param>
        <param name="comm_id">210</param>
        <param name="model_num">6003</param>
      </gpio>

      <gpio name="dxl114">
        <command_interface name="Goal Position"/>
        <command_interface name="Goal Current"/>
        <state_interface name="Present Position"/>
        <state_interface name="Present Velocity"/>
        <state_interface name="Present Current"/>
        <param name="type">virtual_dxl</param>
        <param name="ID">114</param>
        <param name="comm_id">210</param>
        <param name="model_num">6004</param>
      </gpio>

      <gpio name="finger_r_sensor1">
        <state_interface name="Present Pressure 5"/>
        <param name="type">virtual_sensor</param>
        <param name="ID">115</param>
        <param name="comm_id">210</param>
        <param name="model_num">6005</param>
      </gpio>

      <gpio name="dxl116">
        <command_interface name="Goal Position"/>
        <command_interface name="Goal Current"/>
        <state_interface name="Present Position"/>
        <state_interface name="Present Velocity"/>
        <state_interface name="Present Current"/>
        <param name="type">virtual_dxl</param>
        <param name="ID">116</param>
        <param name="comm_id">210</param>
        <param name="model_num">6006</param>
      </gpio>

      <gpio name="dxl117">
        <command_interface name="Goal Position"/>
        <command_interface name="Goal Current"/>
        <state_interface name="Present Position"/>
        <state_interface name="Present Velocity"/>
        <state_interface name="Present Current"/>
        <param name="type">virtual_dxl</param>
        <param name="ID">117</param>
        <param name="comm_id">210</param>
        <param name="model_num">6007</param>
      </gpio>

      <gpio name="dxl118">
        <command_interface name="Goal Position"/>
        <command_interface name="Goal Current"/>
        <state_interface name="Present Position"/>
        <state_interface name="Present Velocity"/>
        <state_interface name="Present Current"/>
        <param name="type">virtual_dxl</param>
        <param name="ID">118</param>
        <param name="comm_id">210</param>
        <param name="model_num">6008</param>
      </gpio>

      <gpio name="dxl119">
        <command_interface name="Goal Position"/>
        <command_interface name="Goal Current"/>
        <state_interface name="Present Position"/>
        <state_interface name="Present Velocity"/>
        <state_interface name="Present Current"/>
        <param name="type">virtual_dxl</param>
        <param name="ID">119</param>
        <param name="comm_id">210</param>
        <param name="model_num">6009</param>
      </gpio>

      <gpio name="finger_r_sensor2">
        <state_interface name="Present Pressure 5"/>
        <param name="type">virtual_sensor</param>
        <param name="ID">120</param>
        <param name="comm_id">210</param>
        <param name="model_num">6010</param>
      </gpio>

      <gpio name="dxl121">
        <command_interface name="Goal Position"/>
        <command_interface name="Goal Current"/>
        <state_interface name="Present Position"/>
        <state_interface name="Present Velocity"/>
        <state_interface name="Present Current"/>
        <param name="type">virtual_dxl</param>
        <param name="ID">121</param>
        <param name="comm_id">210</param>
        <param name="model_num">6011</param>
      </gpio>

      <gpio name="dxl122">
        <command_interface name="Goal Position"/>
        <command_interface name="Goal Current"/>
        <state_interface name="Present Position"/>
        <state_interface name="Present Velocity"/>
        <state_interface name="Present Current"/>
        <param name="type">virtual_dxl</param>
        <param name="ID">122</param>
        <param name="comm_id">210</param>
        <param name="model_num">6012</param>
      </gpio>

      <gpio name="dxl123">
        <command_interface name="Goal Position"/>
        <command_interface name="Goal Current"/>
        <state_interface name="Present Position"/>
        <state_interface name="Present Velocity"/>
        <state_interface name="Present Current"/>
        <param name="type">virtual_dxl</param>
        <param name="ID">123</param>
        <param name="comm_id">210</param>
        <param name="model_num">6013</param>
      </gpio>

      <gpio name="dxl124">
        <command_interface name="Goal Position"/>
        <command_interface name="Goal Current"/>
        <state_interface name="Present Position"/>
        <state_interface name="Present Velocity"/>
        <state_interface name="Present Current"/>
        <param name="type">virtual_dxl</param>
        <param name="ID">124</param>
        <param name="comm_id">210</param>
        <param name="model_num">6014</param>
      </gpio>

      <gpio name="finger_r_sensor3">
        <state_interface name="Present Pressure 5"/>
        <param name="type">virtual_sensor</param>
        <param name="ID">125</param>
        <param name="comm_id">210</param>
        <param name="model_num">6015</param>
      </gpio>

      <gpio name="dxl126">
        <command_interface name="Goal Position"/>
        <command_interface name="Goal Current"/>
        <state_interface name="Present Position"/>
        <state_interface name="Present Velocity"/>
        <state_interface name="Present Current"/>
        <param name="type">virtual_dxl</param>
        <param name="ID">126</param>
        <param name="comm_id">210</param>
        <param name="model_num">6016</param>
      </gpio>

      <gpio name="dxl127">
        <command_interface name="Goal Position"/>
        <command_interface name="Goal Current"/>
        <state_interface name="Present Position"/>
        <state_interface name="Present Velocity"/>
        <state_interface name="Present Current"/>
