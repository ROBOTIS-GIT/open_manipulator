      <!-- ════════════════════════════════════════════════════════════════════
           [Step 4] HX5 hub (ID 110) — Table Sync Enable=1 (dummy controller)
                    Same ID as Step 2 but only flips the Enable bit. The hub
                    SyncTable is now armed; HX5 motors are driven from
                    Tool Bus packets relayed by OMY END.
           ════════════════════════════════════════════════════════════════════ -->
      <gpio name="hand_r_controller_dummy">
        <param name="type">controller</param>
        <param name="ID">110</param>
        <param name="Table Sync Enable">1</param>
      </gpio>

      </xacro:if>

      <!-- Normal launches do not write ID 110 directly. In the observed
           hardware logs ID 110 ping succeeds through OMY END pass-through,
           but any write waits for a status packet and aborts hardware init.
           OMY END ID 210 is configured above and later armed from launch. -->

      <!-- ════════════════════════════════════════════════════════════════════
           [Step 5] Virtual DXL / sensor mapping (BulkRead/BulkWrite buffer)
                    comm_id=210  →  routed via OMY END SyncTable relay.
	           ════════════════════════════════════════════════════════════════════ -->
      <!-- Finger 1: dxl111-114 -->
      <gpio name="dxl111"><command_interface name="Goal Position"/><command_interface name="Goal Current"/><state_interface name="Present Position"/><state_interface name="Present Velocity"/><state_interface name="Present Current"/><param name="type">virtual_dxl</param><param name="ID">111</param><param name="comm_id">210</param><param name="model_num">6001</param></gpio>
      <gpio name="dxl112"><command_interface name="Goal Position"/><command_interface name="Goal Current"/><state_interface name="Present Position"/><state_interface name="Present Velocity"/><state_interface name="Present Current"/><param name="type">virtual_dxl</param><param name="ID">112</param><param name="comm_id">210</param><param name="model_num">6002</param></gpio>
