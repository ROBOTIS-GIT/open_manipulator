<?xml version="1.0"?>
<package format="3">
  <name>open_manipulator_joint_impedance_controller</name>
  <version>0.1.0</version>
  <description>Separate real-time joint impedance plugin reusing OMY gravity and friction compensation.</description>
  <maintainer email="pyo@robotis.com">ROBOTIS</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>open_manipulator_friction_diagnostic</depend>
  <depend>controller_interface</depend><depend>pluginlib</depend>
  <depend>rclcpp</depend><depend>rclcpp_lifecycle</depend>
  <depend>rcl_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>realtime_tools</depend><depend>std_msgs</depend><depend>control_msgs</depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>dynamixel_interfaces</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>open_manipulator_bringup</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
