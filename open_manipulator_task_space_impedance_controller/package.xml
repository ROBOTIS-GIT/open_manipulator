  <version>0.1.0</version>
  <description>Classical Jacobian-transpose Cartesian impedance with existing OMY compensation.</description>
  <maintainer email="pyo@robotis.com">ROBOTIS</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>open_manipulator_friction_diagnostic</depend>
  <depend>controller_interface</depend><depend>pluginlib</depend>
  <depend>rclcpp</depend><depend>rclcpp_lifecycle</depend>
  <depend>rcl_interfaces</depend><depend>geometry_msgs</depend>
  <depend>realtime_tools</depend><depend>std_msgs</depend><depend>std_srvs</depend>
  <depend>control_msgs</depend><depend>eigen</depend>
  <depend>liborocos-kdl-dev</depend><depend>kdl_parser</depend>
